[Unit]
Description=Sync Hyprland resolution with QEMU virtio-gpu display size
Documentation=https://github.com/smnmsr/hyprland-guest-resize
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/sync-guest-display
Restart=always
RestartSec=2

# Override the auto-detected output if needed:
# Environment=SYNC_GUEST_OUTPUT=Virtual-1

[Install]
WantedBy=graphical-session.target
